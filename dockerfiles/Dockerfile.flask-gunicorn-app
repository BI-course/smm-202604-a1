# ============================
# Stage 1: Build dependencies
# ============================
# A "multi-stage" build: this first stage installs the Python packages.
# The build tools (gcc) stay in this stage and are thrown away, so the final
# image is smaller.
FROM python:3.12.10-slim AS builder

WORKDIR /build

# Build tools, only needed in this first stage
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

# Install ONLY what api.py needs to run, using the pinned versions.
# requirements/serving.txt pins scikit-learn==1.6.1 because our models were
# saved with that version.
COPY requirements/serving.txt ./requirements/serving.txt
RUN pip install --no-cache-dir --prefix=/install -r requirements/serving.txt

# Copy the API code and the four saved models into the image.
# If the models are ever replaced, rebuild the image:
#   docker compose -f docker-compose.yaml -f docker-compose-dev.yaml build flask-gunicorn-app
COPY api.py .
COPY model/ model/

# ============================
# Stage 2: Runtime image
# ============================
FROM python:3.12.10-slim

WORKDIR /opt/app-smm
ENV PYTHONPATH=/opt/app-smm

# Copy only the installed packages (no compilers, no caches)
COPY --from=builder /install /usr/local

# Copy the application code and the model/ folder
COPY --from=builder /build /opt/app-smm

# Port 8000 is only reachable by other containers (Nginx), not from your laptop
EXPOSE 8000

# Gunicorn (NOT the Flask development server) serves the API.
# 2 workers keep memory use small; Docker Compose can run more containers.
CMD ["gunicorn", "--chdir", "/opt/app-smm", "-w", "2", "-b", "0.0.0.0:8000", "api:app"]
